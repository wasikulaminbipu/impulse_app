# GitLab CI Pipeline for Flutter & Fastlane Deployment
# Strictly enforces fresh dependency compilation and secret sanitization

image: ghcr.io/cirruslabs/flutter:stable

stages:
  - quality
  - build
  - deploy

variables:
  FASTLANE_SKIP_UPDATE_CHECK: "1"
  FASTLANE_HIDE_CHANGELOG: "1"
  FASTLANE_DISABLE_ANIMATION: "1"
  CI: "true"

# Stage 1: Quality Gate
quality_gate:
  stage: quality
  script:
    - flutter pub get
    - flutter analyze --fatal-infos --fatal-warnings
    - flutter test --coverage
    - dart run bin/audit_fastlane.dart
  rules:
    - if: '$CI_COMMIT_TAG =~ /^v/'
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'

# Stage 2: Build Artifacts
build_release:
  stage: build
  script:
    - echo "$PLAYSTORE_UPLOAD_KEYSTORE_BASE64" | base64 -d > android/app/upload-keystore.jks
    - echo "$PLAYSTORE_KEY_PROPERTIES" | base64 -d > android/key.properties
    - flutter build appbundle --release --obfuscate --split-debug-info=build/app/outputs/symbols
  artifacts:
    paths:
      - build/app/outputs/bundle/release/app-release.aab
      - build/app/outputs/mapping/release/mapping.txt
    expire_in: 7 days
  rules:
    - if: '$CI_COMMIT_TAG =~ /^v/'

# Stage 3: Fastlane Deployment
deploy_playstore:
  stage: deploy
  image: ruby:3.3
  dependencies:
    - build_release
  before_script:
    - cd android
    - gem install bundler
    - bundle install
  script:
    - echo "$PLAYSTORE_SERVICE_ACCOUNT_JSON" > pc-api-key.json
    - bundle exec fastlane alpha
  after_script:
    - rm -f android/pc-api-key.json
  rules:
    - if: '$CI_COMMIT_TAG =~ /^v/'
